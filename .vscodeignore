# What stays out of the .vsix. Everything is bundled into dist/ by esbuild, so the vsix only needs
# dist/, media/, package.json, LICENSE, README, CHANGELOG — no sources, no toolchain, no deps.

# Sources and build inputs (bundled into dist/)
src/**
webview/**
esbuild.mjs
svelte.config.mjs
tsconfig*.json

# Dev-only tooling and notes
tools/**
docs/**
.vscode/**
.github/**
CLAUDE.md
AGENTS.md
# Design source handed over by the design agent — reference material, not a build input
.design-import/**
*.zip
.gitignore
.gitattributes
.vscodeignore
package-lock.json
yarn.lock

# Raw ACP wire captures: machine paths and prompt content. Must never leave this machine.
recordings/**

# Local secrets — never ship
.dev.vars
.env
.env.*

# Source maps: useful in the dev host, dead weight (and full of local paths) in a shipped vsix
**/*.map

# Never ship a nested vsix
*.vsix

# Font sources. esbuild copies them to dist/fonts/ and rewrites the url()s in dist/webview.css to
# point there, so shipping media/fonts/ too would duplicate ~176KB that nothing loads.
media/fonts/**

# Store/social promo art — used when publishing the listing, never loaded by the extension
media/promo/**

# Local debug screenshots
issue*.png
_issue*

# Workspace agent paste-ups (written at runtime; never ship in the VSIX)
.grok-attachments/**
